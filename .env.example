# Contact form email delivery (used by api/contact.ts on Vercel).
# Without RESEND_API_KEY the form opens the visitor's email app instead.
RESEND_API_KEY=""
# Inbox that receives enquiries (default: hello@blackfamestudios.com)
CONTACT_TO_EMAIL=""
# Verified sender address in Resend, e.g. "BlackFame Website <website@blackfamestudios.com>"
CONTACT_FROM_EMAIL=""
